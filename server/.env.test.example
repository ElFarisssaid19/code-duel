# Test environment, used by `npm test` (Vitest).
# Copy to server/.env.test:  cp server/.env.test.example server/.env.test
#
# The database name MUST end in "_test": the test setup refuses to run otherwise,
# because every table is wiped between tests. The database is created and migrated
# automatically (`prisma migrate deploy`) before the tests run.

NODE_ENV=test
PORT=4001
CLIENT_URL=http://localhost:5173
DATABASE_URL=mysql://codeduel:change-me@localhost:3306/code_duel_test?allowPublicKeyRetrieval=true
JWT_SECRET=test-only-secret-that-is-at-least-32-characters-long
JUDGE_URL=http://localhost:5050
JUDGE_PROVIDER=gojudge
