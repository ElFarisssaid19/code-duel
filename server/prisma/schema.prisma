// Prisma 7 schema. The connection URL lives in prisma.config.js, not here.
// Docs: https://www.prisma.io/docs/orm/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Node 24 runs the generated .ts files natively (type stripping), which
  // requires explicit .ts extensions on relative imports.
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// Verdict of a judged submission (same values as the judge service statuses).
enum SubmissionStatus {
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILE_ERROR
  INTERNAL_ERROR
}

/// WAITING (players found, connecting) → COUNTDOWN (3 s) → ACTIVE → FINISHED | CANCELLED
enum MatchStatus {
  WAITING
  COUNTDOWN
  ACTIVE
  FINISHED
  CANCELLED
}

/// RANKED: matchmaking queue, updates ELO. PRIVATE: room code / invite link, unranked.
/// GHOST: against a replay of a past ranked run (or a bot); only the human's rating changes (K=16).
enum MatchMode {
  RANKED
  PRIVATE
  GHOST
}

/// ALGO: function-style algorithm problems judged by go-judge. FRONTEND: reproduce a target
/// image with HTML/CSS, scored by pixel comparison (renderer service). DEBUG: fix buggy code
/// (same judge and harness as ALGO).
enum Category {
  ALGO
  FRONTEND
  DEBUG
}

/// FRONTEND tracks. HTML: HTML only, no CSS. CSS: fixed HTML, write CSS only. HTML_CSS: both.
enum FrontendTrack {
  HTML
  CSS
  HTML_CSS
}

enum MatchEndReason {
  SOLVED
  TIMEOUT
  FORFEIT
  DISCONNECT
  CANCELLED
}

model User {
  id                     Int       @id @default(autoincrement())
  username               String    @unique @db.VarChar(32)
  email                  String    @unique @db.VarChar(255)
  passwordHash           String    @db.VarChar(255)
  /// Incremented to revoke every session (password change, "log out of all devices").
  /// Embedded in the JWT; tokens with an older version are rejected.
  tokenVersion           Int       @default(0)
  /// Default editor language for practice and duels
  preferredLanguage      String    @default("javascript") @db.VarChar(16)
  /// Whether this user's ranked runs may be replayed as ghosts for other players
  allowGhosts            Boolean   @default(true)
  /// When the user dismissed the "your ranked runs may be replayed as ghosts" notice (null = not
  /// yet: Home shows a one-time banner). Set at registration, where the notice is shown.
  ghostNoticeDismissedAt DateTime?
  createdAt              DateTime  @default(now())

  matchesAsPlayer1 Match[]      @relation("MatchPlayer1")
  matchesAsPlayer2 Match[]      @relation("MatchPlayer2")
  matchesWon       Match[]      @relation("MatchWinner")
  ghostMatches     Match[]      @relation("MatchGhost")
  submissions      Submission[]
  shares           MatchShare[]
  /// One rating per category (ALGO, FRONTEND). A missing row means the defaults (1000, 0/0/0).
  ratings          UserRating[]
}

/// ELO and ranked win/loss/draw counters, separately per category.
model UserRating {
  id       Int      @id @default(autoincrement())
  userId   Int
  category Category
  elo      Int      @default(1000)
  wins     Int      @default(0)
  losses   Int      @default(0)
  draws    Int      @default(0)
  /// Highest ELO ever reached in this category (starts at 1000)
  bestElo  Int      @default(1000)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  /// Leaderboard order per category: elo desc, wins desc (then oldest account, from User)
  @@index([category, elo(sort: Desc), wins(sort: Desc)])
}

model Problem {
  id           Int        @id @default(autoincrement())
  title        String     @db.VarChar(200)
  slug         String     @unique @db.VarChar(200)
  description  String     @db.Text
  difficulty   Difficulty
  category     Category   @default(ALGO)
  /// ALGO: per-language starter code { "javascript": "...", "python": "..." }.
  /// DEBUG: the buggy code per language (the editor starts with it; lines changed are counted from it).
  /// FRONTEND: { "html": "...", "css": "..." }.
  starterCode  Json
  /// DEBUG: number of bugs to fix (1-3)
  bugCount     Int?
  /// ALGO: per-language name of the function the harness calls: { "javascript": "twoSum", "python": "two_sum" }.
  /// null for FRONTEND problems.
  functionName Json?
  /// Time limit per test case (ALGO)
  timeLimitMs  Int        @default(2000)
  createdAt    DateTime   @default(now())

  // FRONTEND only (null for ALGO problems)
  track           FrontendTrack?
  canvasWidth     Int?
  canvasHeight    Int?
  /// CSS track: the HTML every submission is rendered with (read-only for players)
  fixedHtml       String?        @db.Text
  /// Colors used by the target: ["#0f172a", "#f59e0b", ...]
  palette         Json?
  /// Score (0-100) needed to count as solved, e.g. 99.50
  matchThreshold  Decimal?       @db.Decimal(5, 2)
  /// Target PNG, relative to the server's data directory (generated by the seed)
  targetImagePath String?        @db.VarChar(255)
  /// Reference solution. Never sent to clients; the seed renders it to make the target.
  referenceHtml   String?        @db.Text
  referenceCss    String?        @db.Text

  testCases   TestCase[]
  matches     Match[]
  submissions Submission[]

  @@index([category, difficulty])
}

model TestCase {
  id             Int     @id @default(autoincrement())
  problemId      Int
  /// Position in the problem's test list (samples first)
  order          Int
  /// JSON array of arguments passed to the function, e.g. [[2, 7, 11, 15], 9]
  input          Json
  /// JSON value the function must return. Never sent into the sandbox.
  expectedOutput Json
  isHidden       Boolean @default(false)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, order])
}

model Match {
  id         Int             @id @default(autoincrement())
  mode       MatchMode       @default(RANKED)
  category   Category        @default(ALGO)
  /// FRONTEND track filter chosen for this match (null = any track, and always null for ALGO)
  track      FrontendTrack?
  status     MatchStatus     @default(WAITING)
  endReason  MatchEndReason?
  /// Private room code (null for ranked matches)
  roomCode   String?         @db.VarChar(6)
  player1Id  Int
  /// null for GHOST matches (the opponent is a replay or a bot, not a participant)
  player2Id  Int?
  problemId  Int
  /// null on a draw or while the match isn't finished
  winnerId   Int?
  /// Match length (by difficulty: EASY 10 min, MEDIUM 15 min, HARD 20 min)
  durationMs Int
  /// Number of tests (samples + hidden) of the problem. FRONTEND: 1 (passed = 1 once solved).
  testCount  Int

  /// ELO of each player when the match was created
  player1Elo       Int
  player2Elo       Int
  /// ELO change applied when the match ended (ranked only; null otherwise)
  player1EloChange Int?
  player2EloChange Int?
  /// Best number of tests passed, and when that count was first reached (timeout tiebreak)
  player1Passed    Int       @default(0)
  player2Passed    Int       @default(0)
  player1ReachedAt DateTime?
  player2ReachedAt DateTime?
  /// FRONTEND: best score (0-100) and the character count of that submission (timeout tiebreak)
  player1Score     Decimal?  @db.Decimal(5, 2)
  player2Score     Decimal?  @db.Decimal(5, 2)
  player1Chars     Int?
  player2Chars     Int?
  /// DEBUG: lines changed (vs the buggy code) of each player's best submission (timeout tiebreak)
  player1Lines     Int?
  player2Lines     Int?

  /// GHOST mode: whose past ranked run is replayed (null for a bot), which match it came from,
  /// or which bot played. player2Elo is the ghost's rating at that time (or the bot's rating).
  ghostUserId        Int?
  ghostSourceMatchId Int?
  botId              String? @db.VarChar(32)
  /// GHOST mode: the ghost/bot won (winnerId can only point to real users)
  winnerIsGhost      Boolean @default(false)

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endsAt    DateTime?
  endedAt   DateTime?

  // Match history is kept: users/problems with matches cannot be deleted.
  player1          User         @relation("MatchPlayer1", fields: [player1Id], references: [id], onDelete: Restrict)
  player2          User?        @relation("MatchPlayer2", fields: [player2Id], references: [id], onDelete: Restrict)
  ghostUser        User?        @relation("MatchGhost", fields: [ghostUserId], references: [id], onDelete: SetNull)
  /// GHOST mode: the ranked match whose run is replayed (its date is shown as "replay from …")
  ghostSourceMatch Match?       @relation("GhostSource", fields: [ghostSourceMatchId], references: [id], onDelete: SetNull)
  ghostReplays     Match[]      @relation("GhostSource")
  winner           User?        @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  problem          Problem      @relation(fields: [problemId], references: [id], onDelete: Restrict)
  submissions      Submission[]
  shares           MatchShare[]

  @@index([player1Id, createdAt])
  @@index([player2Id, createdAt])
  /// Match history (finished matches by end date)
  @@index([player1Id, endedAt])
  @@index([player2Id, endedAt])
  @@index([problemId])
  @@index([winnerId])
  @@index([status])
  /// Ghost candidates: finished ranked runs per category
  @@index([mode, status, category])
  @@index([ghostUserId])
}

model Submission {
  id           Int              @id @default(autoincrement())
  /// null for solo practice submissions
  matchId      Int?
  userId       Int
  problemId    Int
  /// ALGO: javascript | python. FRONTEND: html | css | html_css (the track).
  language     String           @db.VarChar(32)
  /// ALGO: the source code. FRONTEND: the player's HTML ("" for the CSS track).
  code         String           @db.Text
  /// FRONTEND: the player's CSS ("" for the HTML track); null for ALGO
  css          String?          @db.Text
  status       SubmissionStatus
  passed       Int              @default(0)
  total        Int              @default(0)
  /// CPU time of the whole run (ALGO)
  timeMs       Int?
  /// FRONTEND: pixel score 0-100 (null for ALGO)
  score        Decimal?         @db.Decimal(5, 2)
  /// FRONTEND: non-whitespace characters written by the player (timeout tiebreak)
  charCount    Int?
  /// DEBUG: lines changed compared to the buggy code (timeout tiebreak)
  linesChanged Int?
  createdAt    DateTime         @default(now())

  match   Match?  @relation(fields: [matchId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([matchId])
  /// Match timeline and each player's last submission
  @@index([matchId, userId, createdAt])
  @@index([userId, problemId])
  @@index([problemId])
}

/// A public share link for one player's result card of a finished match (one per user per match).
/// Deleting the row revokes the link (GET /s/:shareId → 404).
model MatchShare {
  id        Int      @id @default(autoincrement())
  /// Unguessable public id (128 random bits, base64url)
  shareId   String   @unique @db.VarChar(32)
  matchId   Int
  userId    Int
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
}
