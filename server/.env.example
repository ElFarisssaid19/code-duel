# Copy to server/.env:  cp server/.env.example server/.env

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Must match the credentials in infra/.env (MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE / MYSQL_PORT)
DATABASE_URL=mysql://codeduel:change-me@localhost:3306/code_duel?allowPublicKeyRetrieval=true

# At least 32 characters. Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Judge0 CE API (infra/judge0). Default port 2358.
JUDGE0_URL=http://localhost:2358
