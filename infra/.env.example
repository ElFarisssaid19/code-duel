# Copy to infra/.env and set strong values:
#   cp infra/.env.example infra/.env
# Generate a password with: openssl rand -hex 24
# Use URL-safe characters (hex is easiest): the password is also part of
# DATABASE_URL in server/.env.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=code_duel
MYSQL_USER=codeduel
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# go-judge sandbox API port (localhost only)
JUDGE_PORT=5050
