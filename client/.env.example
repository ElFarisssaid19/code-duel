# Copy to client/.env.local if you need overrides. Only VITE_* variables are exposed to the browser.
# Leave these empty in development: the Vite dev server proxies /api and /socket.io to http://localhost:4000.

# Base URL of the REST API (default: /api, same origin)
VITE_API_URL=

# Socket.io server origin (default: same origin as the page)
VITE_SOCKET_URL=
